# =====================================================================================================
# Salin ke .env.local untuk development, dan isi nama yang SAMA di Vercel -> Project -> Settings -> Environment Variables.
# JANGAN commit nilai asli. File ini hanya berisi NAMA variabel dengan nilai kosong.
# Penjelasan lengkap tiap variabel (dari mana nilainya, publik/rahasia): docs/BACKEND_SETUP.md
# =====================================================================================================

# ---------- PUBLIK (aman di browser; awalan NEXT_PUBLIC_ membuatnya masuk bundel klien) ----------
# Firebase Console -> Project settings -> General -> Your apps -> Web app -> SDK setup and configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Supabase Dashboard -> Project Settings -> API (Project URL dan anon / publishable key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------- RAHASIA (HANYA SERVER; jangan pernah memakai awalan NEXT_PUBLIC_) ----------
# Firebase Console -> Project settings -> Service accounts -> Generate new private key (file JSON): isi dari project_id, client_email, private_key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Supabase Dashboard -> Project Settings -> API -> service_role / secret key
SUPABASE_SERVICE_ROLE_KEY=

# ---------- OPSIONAL ----------
# Frekuensi kirim posisi (Hz). Kosong = 10. Turunkan (mis. 6) bila kuota pesan Realtime paket Supabase-mu terlampaui.
NEXT_PUBLIC_NET_SEND_HZ=
# Domain email internal untuk memetakan username -> email Firebase. Kosong = bawaan (lihat lib/auth/identity.ts). Harus sama di klien & server.
NEXT_PUBLIC_AUTH_EMAIL_DOMAIN=
