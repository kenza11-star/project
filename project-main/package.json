{
  "name": "backrooms-lobby",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:game": "sh scripts/run-test.sh",
    "audit:map": "node scripts/audit-map.js",
    "gen:sfx": "python3 scripts/gen-sfx.py",
    "test:net": "tsc -p scripts/tsconfig.test-net.json && node scripts/test-net.js && node scripts/test-poller.js",
    "test:backend": "sh scripts/run-test-backend.sh",
    "check:secrets": "node scripts/check-secrets.js",
    "test:sql": "sh scripts/test-sql.sh",
    "test:voice": "tsc -p scripts/tsconfig.test-voice.json && node scripts/test-voice.js",
    "test:relay": "tsc -p scripts/tsconfig.test-net.json && node scripts/test-relay.js",
    "test:fallback": "tsc -p scripts/tsconfig.test-fallback.json && node scripts/test-fallback.js",
    "test:room": "tsc -p scripts/tsconfig.test-room.json && node scripts/test-room-sync.js",
    "test:drag": "tsc -p scripts/tsconfig.test.json && tsc -p scripts/tsconfig.test-lockers.json && node scripts/test-drag.js",
    "test:capture": "tsc -p scripts/tsconfig.test.json && node scripts/test-capture.js && node scripts/test-capture-audio.js",
    "test:anim": "tsc -p scripts/tsconfig.test-anim.json && node scripts/test-animsmooth.js",
    "test:capture-audio-browser": "tsc -p scripts/tsconfig.test.json && node scripts/test-capture-audio-browser.js",
    "test:lockers": "tsc -p scripts/tsconfig.test-lockers.json && node scripts/test-lockers.js && node blitz-relay/test.js"
  },
  "dependencies": {
    "@pixiv/three-vrm": "2.1.3",
    "@supabase/supabase-js": "^2.49.0",
    "firebase": "^11.0.0",
    "firebase-admin": "^13.0.0",
    "lucide-react": "^0.453.0",
    "next": "14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "0.164.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/three": "0.164.0",
    "typescript": "^5.5.0"
  }
}
