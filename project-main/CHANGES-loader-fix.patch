+// Pemuat GLB dengan deteksi macet (bukan sekadar timeout besar): gagal bila fase UNDUH tidak ada kemajuan selama `stallMs`, atau total melewati `maxMs`
+// (mencakup decode tekstur). Penyebab layar Loading menggantung: GLTFLoader tidak punya timeout, jadi satu request yang macet = Promise tak pernah selesai.
+function loadGlb(url: string, o: { stallMs: number; maxMs: number; onProgress?: (p: number) => void }): Promise<any> {
+  return new Promise((res, rej) => {
+    let done = false; let stallT: ReturnType<typeof setTimeout> | undefined; let maxT: ReturnType<typeof setTimeout> | undefined;
+    const end = (fn: () => void) => { if (done) return; done = true; clearTimeout(stallT); clearTimeout(maxT); fn(); };
+    const arm = () => { clearTimeout(stallT); stallT = setTimeout(() => end(() => rej(new Error('Unduhan macet: ' + url))), o.stallMs); };
+    arm(); maxT = setTimeout(() => end(() => rej(new Error('Pemuatan terlalu lama: ' + url))), o.maxMs);
+    try {
+      new GLTFLoader().load(url, (g) => end(() => res(g)), (e: ProgressEvent) => {
+        if (done) return;
+        if (e.total && e.loaded >= e.total) clearTimeout(stallT); else arm(); // unduhan selesai: tinggal parse/decode (dibatasi maxMs)
+        if (e.total) o.onProgress?.(e.loaded / e.total);
+      }, (err) => end(() => rej(err)));
+    } catch (err) { end(() => rej(err)); }
+  });
+}
